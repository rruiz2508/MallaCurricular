# Copiar a .env y completar. No subir .env al repositorio.

# Conexión directa a Postgres de Supabase (Project Settings > Database).
# Formato: postgresql+asyncpg://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# URL del proyecto Supabase; de aquí se obtienen las claves públicas para validar el JWT.
SUPABASE_URL=https://ucvhxzjzwapvftebmzcv.supabase.co

# Clave secreta del proyecto (Project Settings > API Keys > secret key). Solo la usa el
# backend para crear usuarios y cambiar contraseñas en Supabase Auth. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173
